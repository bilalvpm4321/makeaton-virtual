# Neon: pooled URL (-pooler host) for the app, direct URL for migrations. `neon env pull` writes both.
# Required in production. Local development uses the Docker database below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brightloop"
# Direct (non-pooled) URL. Used by `prisma migrate deploy`, which runs in the Vercel build.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/brightloop"
# Signs session cookies. At least 32 random characters, for example: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
# Public base URL, used in email links and the GitHub callback. Production: https://makeaton-virtual.vercel.app
APP_URL="http://localhost:3000"
# Authorises the billing cron. Vercel Cron sends it as a Bearer token; manual calls send it in x-cron-secret.
CRON_SECRET="change-me"
CURRENCY="INR"

# GitHub sign-in. Create an OAuth App whose callback is <APP_URL>/api/auth/github/callback.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Transactional email via Resend. MAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=""
MAIL_FROM="Brightloop <billing@your-domain.com>"
# Optional reply-to address.
MAIL_REPLY_TO=""

# Shows the demo logins on the sign-in page. Keep false in production.
SHOW_DEMO_LOGINS="false"

# First admin, created by `npm run db:bootstrap`. The password must be more than 8 characters
# with an uppercase letter, a lowercase letter and a special character. Not needed in Vercel.
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD=""
# Set to true once to replace the password of an existing admin account.
BOOTSTRAP_RESET_PASSWORD="false"

# Lets `npm run db:seed` run against a production or Neon database. It wipes every table. Never set it in Vercel.
ALLOW_DEMO_SEED="false"

# Number of generated subscriptions for seeding; set 5000 for the perf test.
SEED_SCALE="200"
# Optional real email. Leave SMTP_HOST empty to only log mails to EmailLog (/outbox).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Brightloop <billing@brightloop.test>"
